#!/usr/bin/env python3
"""Control plane for the Dicebag Lan Mouse Omarchy plugin.

Talks to lan-mouse (config file + optional live CLI), Tailscale, and a
clipboard helper. Prints one JSON object for every verb the panel calls.
"""
from __future__ import annotations

import argparse
import ipaddress
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

PLUGIN_ID = "io.github.dicebagstudios.lan-mouse"
PORT_DEFAULT = 4242
CLIP_PORT = 4243
TAILSCALE_CGNAT = ipaddress.ip_network("100.64.0.0/10")
RELEASE_BIND = ["KeyLeftCtrl", "KeyLeftShift", "KeyLeftMeta", "KeyLeftAlt"]
CONFIG_PATH = Path.home() / ".config" / "lan-mouse" / "config.toml"
CERT_PATH = Path.home() / ".config" / "lan-mouse" / "lan-mouse.pem"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / PLUGIN_ID
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / PLUGIN_ID
PID_PATH = RUNTIME_DIR / "lan-mouse.pid"
CLIP_PID_PATH = RUNTIME_DIR / "clipboard-recv.pid"
LOG_PATH = RUNTIME_DIR / "lan-mouse.log"
DESIRED_PATH = STATE_DIR / "desired"
PLUGIN_ROOT = Path(__file__).resolve().parent.parent
PUSH_SCRIPT = PLUGIN_ROOT / "scripts" / "clipboard-push"
RECV_SCRIPT = PLUGIN_ROOT / "scripts" / "clipboard-recv"


def die(message: str, code: int = 1) -> None:
    print(json.dumps({"ok": False, "error": message}))
    raise SystemExit(code)


def run(cmd: list[str], timeout: float = 4.0, input_bytes: bytes | None = None) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            cmd,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
            input=None if input_bytes is None else input_bytes.decode("utf-8", "replace"),
        )
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 127, "", "not found")
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(cmd, 124, "", "timeout")


def run_bytes(cmd: list[str], timeout: float, data: bytes) -> subprocess.CompletedProcess[bytes]:
    try:
        return subprocess.run(cmd, check=False, capture_output=True, timeout=timeout, input=data)
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        code = 127 if isinstance(exc, FileNotFoundError) else 124
        return subprocess.CompletedProcess(cmd, code, b"", b"")


def ensure_dirs() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_DIR.chmod(0o700)
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
    RUNTIME_DIR.chmod(0o700)
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)


def pid_alive(path: Path, expected: str) -> int | None:
    try:
        pid = int(path.read_text().strip())
    except (OSError, ValueError):
        return None
    comm = Path(f"/proc/{pid}/comm")
    cmdline = Path(f"/proc/{pid}/cmdline")
    if not comm.exists():
        return None
    try:
        name = comm.read_text().strip()
        args = cmdline.read_bytes().replace(b"\x00", b" ").decode("utf-8", "replace")
    except OSError:
        return None
    if expected not in name and expected not in args:
        return None
    try:
        if os.stat(f"/proc/{pid}").st_uid != os.getuid():
            return None
    except OSError:
        return None
    return pid


def package_version() -> str | None:
    proc = run(["lan-mouse", "--version"])
    if proc.returncode != 0:
        which = shutil.which("lan-mouse")
        return None if not which else "unknown"
    text = (proc.stdout or proc.stderr).strip()
    return text.split()[-1] if text else "unknown"


def fingerprint_from_pem() -> str | None:
    if not CERT_PATH.exists():
        return None
    proc = run(["openssl", "x509", "-in", str(CERT_PATH), "-noout", "-fingerprint", "-sha256"])
    if proc.returncode != 0:
        return None
    line = proc.stdout.strip()
    if "=" not in line:
        return None
    return line.split("=", 1)[1].strip().lower()


def tailscale_status() -> dict:
    empty = {
        "installed": shutil.which("tailscale") is not None,
        "running": False,
        "selfName": "",
        "selfDns": "",
        "selfIp": "",
        "peers": [],
        "sshLikely": False,
    }
    if not empty["installed"]:
        return empty
    proc = run(["tailscale", "status", "--json"], timeout=5)
    if proc.returncode != 0:
        return empty
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return empty
    self_info = data.get("Self") or {}
    ips = [ip for ip in (self_info.get("TailscaleIPs") or []) if ":" not in ip]
    self_ip = ips[0] if ips else ""
    dns = str(self_info.get("DNSName") or "").rstrip(".")
    host = dns.split(".")[0] if dns else str(self_info.get("HostName") or "")
    peers = []
    for node in (data.get("Peer") or {}).values():
        os_name = str(node.get("OS") or "")
        peer_ips = [ip for ip in (node.get("TailscaleIPs") or []) if ":" not in ip]
        peer_dns = str(node.get("DNSName") or "").rstrip(".")
        name = peer_dns.split(".")[0] if peer_dns else str(node.get("HostName") or "")
        online = bool(node.get("Online"))
        shareable = os_name.lower() in ("linux", "windows", "macos", "mac os", "darwin")
        peers.append(
            {
                "name": name,
                "dnsName": peer_dns,
                "os": os_name,
                "online": online,
                "ips": peer_ips,
                "shareable": shareable,
            }
        )
    peers.sort(key=lambda p: (not p["online"], p["name"].lower()))
    return {
        "installed": True,
        "running": str(data.get("BackendState") or "") == "Running" and bool(self_ip),
        "selfName": host,
        "selfDns": dns,
        "selfIp": self_ip,
        "peers": peers,
        "sshLikely": True,
    }


def load_config() -> dict:
    cfg = {
        "port": PORT_DEFAULT,
        "release_bind": list(RELEASE_BIND),
        "authorized_fingerprints": {},
        "clients": [],
        "clipboard": True,
    }
    if not CONFIG_PATH.exists():
        return cfg
    try:
        import tomllib
    except ImportError:
        return cfg
    try:
        raw = tomllib.loads(CONFIG_PATH.read_text())
    except (OSError, tomllib.TOMLDecodeError):
        return cfg
    cfg["port"] = int(raw.get("port") or PORT_DEFAULT)
    if isinstance(raw.get("release_bind"), list) and raw["release_bind"]:
        cfg["release_bind"] = [str(x) for x in raw["release_bind"]]
    fps = raw.get("authorized_fingerprints") or {}
    if isinstance(fps, dict):
        cfg["authorized_fingerprints"] = {str(k).lower(): str(v) for k, v in fps.items()}
    clients = []
    for item in raw.get("clients") or []:
        if not isinstance(item, dict):
            continue
        hostname = str(item.get("hostname") or "")
        ips = [str(ip) for ip in (item.get("ips") or [])]
        clients.append(
            {
                "hostname": hostname,
                "position": str(item.get("position") or "right"),
                "port": int(item.get("port") or cfg["port"]),
                "ips": ips,
                "activate_on_startup": bool(item.get("activate_on_startup", True)),
                "enter_hook": str(item.get("enter_hook") or ""),
            }
        )
    cfg["clients"] = clients
    cfg["clipboard"] = any(c.get("enter_hook") for c in clients) if clients else desired_clipboard()
    return cfg


def toml_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def clipboard_hook(hostname: str, ip: str, os_name: str) -> str:
    return f"{PUSH_SCRIPT} {hostname} {ip} {os_name.replace(' ', '')}"


def write_config(cfg: dict) -> None:
    ensure_dirs()
    lines = [
        f"port = {int(cfg.get('port') or PORT_DEFAULT)}",
        "release_bind = [" + ", ".join(f'"{toml_escape(k)}"' for k in (cfg.get("release_bind") or RELEASE_BIND)) + "]",
        "",
        "[authorized_fingerprints]",
    ]
    fps = cfg.get("authorized_fingerprints") or {}
    if not fps:
        lines.append("# paste a peer fingerprint to allow it to control this machine")
    for fp, name in fps.items():
        lines.append(f'"{toml_escape(fp)}" = "{toml_escape(name)}"')
    lines.append("")
    for client in cfg.get("clients") or []:
        hostname = client.get("hostname") or ""
        lines.append("[[clients]]")
        lines.append(f'position = "{toml_escape(client.get("position") or "right")}"')
        if hostname:
            lines.append(f'hostname = "{toml_escape(hostname)}"')
        ips = client.get("ips") or []
        if ips:
            quoted = ", ".join(f'"{toml_escape(ip)}"' for ip in ips)
            lines.append(f"ips = [{quoted}]")
        lines.append(f"port = {int(client.get('port') or cfg.get('port') or PORT_DEFAULT)}")
        lines.append("activate_on_startup = true")
        hook = client.get("enter_hook") or ""
        if hook:
            lines.append(f'enter_hook = "{toml_escape(hook)}"')
        lines.append("")
    CONFIG_PATH.write_text("\n".join(lines).rstrip() + "\n")
    CONFIG_PATH.chmod(0o600)


def desired_on() -> bool:
    try:
        return DESIRED_PATH.read_text().strip() == "on"
    except OSError:
        return False


def desired_clipboard() -> bool:
    path = STATE_DIR / "clipboard"
    try:
        return path.read_text().strip() != "off"
    except OSError:
        return True


def set_desired(value: str) -> None:
    ensure_dirs()
    DESIRED_PATH.write_text(value + "\n")
    DESIRED_PATH.chmod(0o600)


def set_clipboard_flag(enabled: bool) -> None:
    ensure_dirs()
    path = STATE_DIR / "clipboard"
    path.write_text(("on" if enabled else "off") + "\n")
    path.chmod(0o600)


def cli_list() -> list[dict]:
    proc = run(["lan-mouse", "cli", "list"], timeout=2)
    if proc.returncode != 0:
        return []
    rows = []
    for line in proc.stdout.splitlines():
        # id 0: claymore:4242 (right) active: true, ips: [...]
        if not line.startswith("id "):
            continue
        try:
            rest = line[3:]
            handle, remainder = rest.split(":", 1)
            hostport, tail = remainder.strip().split(" ", 1)
            host, port = hostport.rsplit(":", 1)
            pos = "right"
            if "(" in tail and ")" in tail:
                pos = tail.split("(")[1].split(")")[0]
            active = "active: true" in tail
            rows.append(
                {
                    "id": int(handle.strip()),
                    "hostname": host.strip(),
                    "port": int(port),
                    "position": pos,
                    "active": active,
                }
            )
        except (ValueError, IndexError):
            continue
    return rows


def build_status() -> dict:
    ts = tailscale_status()
    cfg = load_config()
    version = package_version()
    daemon_pid = pid_alive(PID_PATH, "lan-mouse")
    clip_pid = pid_alive(CLIP_PID_PATH, "clipboard-recv")
    live = {row["hostname"]: row for row in cli_list()} if daemon_pid else {}
    configured = {c["hostname"]: c for c in cfg["clients"] if c.get("hostname")}
    authorized_by_name = {name: fp for fp, name in cfg["authorized_fingerprints"].items()}
    machines = []
    for peer in ts["peers"]:
        name = peer["name"]
        client = configured.get(name) or {}
        live_row = live.get(name) or {}
        machines.append(
            {
                "name": name,
                "dnsName": peer["dnsName"],
                "os": peer["os"],
                "online": peer["online"],
                "shareable": peer["shareable"],
                "ips": peer["ips"],
                "configured": bool(client),
                "position": client.get("position") or live_row.get("position") or "",
                "active": bool(live_row.get("active")),
                "authorized": name in authorized_by_name,
                "fingerprint": authorized_by_name.get(name, ""),
            }
        )
    extra = [c for name, c in configured.items() if name not in {p["name"] for p in ts["peers"]}]
    for client in extra:
        name = client["hostname"]
        live_row = live.get(name) or {}
        machines.append(
            {
                "name": name,
                "dnsName": name,
                "os": "",
                "online": False,
                "shareable": True,
                "ips": client.get("ips") or [],
                "configured": True,
                "position": client.get("position") or "",
                "active": bool(live_row.get("active")),
                "authorized": name in authorized_by_name,
                "fingerprint": authorized_by_name.get(name, ""),
            }
        )
    return {
        "ok": True,
        "pluginRoot": str(PLUGIN_ROOT),
        "packageInstalled": version is not None,
        "packageVersion": version or "",
        "daemonRunning": daemon_pid is not None,
        "daemonPid": daemon_pid or 0,
        "clipboardRecvRunning": clip_pid is not None,
        "desiredOn": desired_on(),
        "clipboardEnabled": desired_clipboard(),
        "fingerprint": fingerprint_from_pem() or "",
        "port": int(cfg["port"]),
        "tailscale": {
            "installed": ts["installed"],
            "running": ts["running"],
            "selfName": ts["selfName"],
            "selfDns": ts["selfDns"],
            "selfIp": ts["selfIp"],
        },
        "machines": machines,
        "authorized": [{"fingerprint": fp, "name": name} for fp, name in cfg["authorized_fingerprints"].items()],
    }


def restart_daemon_if_running() -> None:
    if pid_alive(PID_PATH, "lan-mouse"):
        stop_daemon()
        time.sleep(0.2)
        start_daemon()


def start_daemon() -> dict:
    ensure_dirs()
    if package_version() is None:
        die("lan-mouse is not installed")
    ts = tailscale_status()
    if not ts["running"]:
        die("Tailscale is not connected")
    cfg = load_config()
    write_config(cfg)
    if pid_alive(PID_PATH, "lan-mouse"):
        set_desired("on")
        if desired_clipboard():
            start_clipboard_recv(ts["selfIp"])
        return build_status()
    log = LOG_PATH.open("ab")
    proc = subprocess.Popen(
        ["lan-mouse", "daemon"],
        stdout=log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        cwd=str(Path.home()),
    )
    PID_PATH.write_text(str(proc.pid) + "\n")
    PID_PATH.chmod(0o600)
    set_desired("on")
    # First start writes the TLS cert.
    for _ in range(20):
        if fingerprint_from_pem():
            break
        time.sleep(0.1)
    if desired_clipboard():
        start_clipboard_recv(ts["selfIp"])
    return build_status()


def stop_process(path: Path, expected: str) -> None:
    pid = pid_alive(path, expected)
    if pid is None:
        try:
            path.unlink()
        except OSError:
            pass
        return
    os.kill(pid, signal.SIGTERM)
    for _ in range(20):
        if not Path(f"/proc/{pid}").exists():
            break
        time.sleep(0.05)
    if Path(f"/proc/{pid}").exists():
        os.kill(pid, signal.SIGKILL)
    try:
        path.unlink()
    except OSError:
        pass


def stop_daemon() -> dict:
    set_desired("off")
    stop_process(CLIP_PID_PATH, "clipboard-recv")
    stop_process(PID_PATH, "lan-mouse")
    return build_status()


def start_clipboard_recv(bind_ip: str) -> None:
    if not bind_ip or pid_alive(CLIP_PID_PATH, "clipboard-recv"):
        return
    if not RECV_SCRIPT.exists():
        return
    log = (RUNTIME_DIR / "clipboard-recv.log").open("ab")
    proc = subprocess.Popen(
        [str(RECV_SCRIPT), bind_ip, str(CLIP_PORT)],
        stdout=log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    CLIP_PID_PATH.write_text(str(proc.pid) + "\n")
    CLIP_PID_PATH.chmod(0o600)


def find_peer(name: str) -> dict | None:
    ts = tailscale_status()
    for peer in ts["peers"]:
        if peer["name"] == name or peer["dnsName"] == name:
            return peer
    return None


def add_peer(name: str, position: str) -> dict:
    if position not in ("left", "right", "top", "bottom"):
        die("position must be left, right, top, or bottom")
    peer = find_peer(name)
    if peer is None:
        die(f"no Tailscale machine named {name}")
    if not peer["shareable"]:
        die(f"{name} is {peer['os']}, which cannot run lan-mouse")
    if not peer["ips"]:
        die(f"{name} has no Tailscale IPv4 address")
    cfg = load_config()
    existing = [c for c in cfg["clients"] if c.get("hostname") != name]
    hook = ""
    if desired_clipboard():
        hook = clipboard_hook(name, peer["ips"][0], peer["os"])
    existing.append(
        {
            "hostname": name,
            "position": position,
            "port": cfg["port"],
            "ips": peer["ips"],
            "activate_on_startup": True,
            "enter_hook": hook,
        }
    )
    cfg["clients"] = existing
    write_config(cfg)
    restart_daemon_if_running()
    return build_status()


def remove_peer(name: str) -> dict:
    cfg = load_config()
    cfg["clients"] = [c for c in cfg["clients"] if c.get("hostname") != name]
    write_config(cfg)
    restart_daemon_if_running()
    return build_status()


def authorize(name: str, fingerprint: str) -> dict:
    fp = fingerprint.strip().lower()
    if ":" not in fp or len(fp) < 32:
        die("that does not look like a lan-mouse fingerprint")
    cfg = load_config()
    cfg["authorized_fingerprints"][fp] = name.strip() or "peer"
    write_config(cfg)
    restart_daemon_if_running()
    return build_status()


def deauthorize(fingerprint: str) -> dict:
    fp = fingerprint.strip().lower()
    cfg = load_config()
    cfg["authorized_fingerprints"].pop(fp, None)
    write_config(cfg)
    restart_daemon_if_running()
    return build_status()


def set_clipboard(enabled: bool) -> dict:
    set_clipboard_flag(enabled)
    cfg = load_config()
    ts = tailscale_status()
    peers = {p["name"]: p for p in ts["peers"]}
    for client in cfg["clients"]:
        name = client.get("hostname") or ""
        peer = peers.get(name)
        ip = (peer["ips"][0] if peer and peer["ips"] else (client.get("ips") or [""])[0])
        os_name = peer["os"] if peer else "linux"
        client["enter_hook"] = clipboard_hook(name, ip, os_name) if enabled else ""
    write_config(cfg)
    if enabled and pid_alive(PID_PATH, "lan-mouse"):
        start_clipboard_recv(ts["selfIp"])
    if not enabled:
        stop_process(CLIP_PID_PATH, "clipboard-recv")
    restart_daemon_if_running()
    return build_status()


def install_packages() -> dict:
    proc = run(["omarchy", "pkg", "add", "lan-mouse", "wl-clipboard"], timeout=180)
    if proc.returncode != 0:
        die((proc.stderr or proc.stdout or "package install failed").strip()[:400])
    return build_status()


def restore() -> dict:
    if desired_on() and package_version() is not None:
        return start_daemon()
    return build_status()


def copy_fingerprint() -> dict:
    fp = fingerprint_from_pem()
    if not fp:
        die("no fingerprint yet; start the daemon once")
    if shutil.which("wl-copy"):
        run_bytes(["wl-copy"], 2, (fp + "\n").encode())
    return {"ok": True, "fingerprint": fp, "copied": True}


def emit(payload: dict) -> None:
    json.dump(payload, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")


def main() -> None:
    parser = argparse.ArgumentParser(prog="ctl")
    parser.add_argument("verb")
    parser.add_argument("--name", default="")
    parser.add_argument("--position", default="right")
    parser.add_argument("--fingerprint", default="")
    parser.add_argument("--enabled", default="")
    args = parser.parse_args()
    verb = args.verb
    if verb == "status":
        emit(build_status())
    elif verb == "start":
        emit(start_daemon())
    elif verb == "stop":
        emit(stop_daemon())
    elif verb == "install":
        emit(install_packages())
    elif verb == "restore":
        emit(restore())
    elif verb == "add-peer":
        emit(add_peer(args.name, args.position))
    elif verb == "remove-peer":
        emit(remove_peer(args.name))
    elif verb == "authorize":
        emit(authorize(args.name, args.fingerprint))
    elif verb == "deauthorize":
        emit(deauthorize(args.fingerprint))
    elif verb == "clipboard":
        if args.enabled not in ("on", "off"):
            die("clipboard --enabled on|off")
        emit(set_clipboard(args.enabled == "on"))
    elif verb == "copy-fingerprint":
        emit(copy_fingerprint())
    else:
        die(f"unknown verb {verb}")


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        raise SystemExit(0)
    except SystemExit:
        raise
    except Exception as exc:
        die(str(exc))
