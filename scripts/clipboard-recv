#!/usr/bin/env python3
"""Accept clipboard text from Tailscale peers and load it with wl-copy.

Binds only to the given Tailscale IPv4 address.
Usage: clipboard-recv <bind-ip> <port>
"""
from __future__ import annotations

import ipaddress
import socket
import struct
import subprocess
import sys

CGNAT = ipaddress.ip_network("100.64.0.0/10")
MAX = 256 * 1024


def allowed(addr: str) -> bool:
    try:
        ip = ipaddress.ip_address(addr)
    except ValueError:
        return False
    return ip in CGNAT


def main() -> None:
    if len(sys.argv) < 3:
        raise SystemExit("usage: clipboard-recv <bind-ip> <port>")
    bind_ip = sys.argv[1]
    port = int(sys.argv[2])
    if not allowed(bind_ip):
        raise SystemExit("bind address is not a Tailscale IPv4")
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind((bind_ip, port))
    sock.listen(4)
    while True:
        conn, remote = sock.accept()
        with conn:
            if not allowed(remote[0]):
                continue
            conn.settimeout(3)
            try:
                header = conn.recv(4)
                if len(header) < 4:
                    continue
                (length,) = struct.unpack("!I", header)
                if length <= 0 or length > MAX:
                    continue
                chunks = []
                got = 0
                while got < length:
                    piece = conn.recv(min(65536, length - got))
                    if not piece:
                        break
                    chunks.append(piece)
                    got += len(piece)
                data = b"".join(chunks)
                if len(data) != length:
                    continue
                subprocess.run(["wl-copy"], input=data, check=False, timeout=2)
            except (OSError, subprocess.TimeoutExpired):
                continue


if __name__ == "__main__":
    main()
