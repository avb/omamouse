#!/bin/bash
# Copy this checkout into ~/.config/omarchy/plugins and reload the shell.
set -euo pipefail
ID=io.github.dicebagstudios.lan-mouse
HERE=$(cd "$(dirname "$0")/.." && pwd)
DEST="$HOME/.config/omarchy/plugins/$ID"
omarchy plugin validate "$HERE"
mkdir -p "$(dirname "$DEST")"
rm -rf "$DEST"
mkdir -p "$DEST"
# cp without -a so mtimes move and the shell watcher notices.
cp -R "$HERE"/. "$DEST"
rm -rf "$DEST/.git"
omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
echo "Installed $ID. Enable with: omarchy plugin enable $ID --section right"
echo "A full shell restart picks up QML that was already mounted: omarchy restart shell"
